# Ports
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Frontend -> Backend (baked into the frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend: the only browser origin allowed to call the API (the frontend URL)
CORS_ORIGIN=http://localhost:3000

# MySQL container
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=boqueue
MYSQL_USER=boqueue_user
MYSQL_PASSWORD=boqueue_password
MYSQL_PORT=3306

# Backend -> Database (inside docker compose the host is the service name `mysql`;
# for local development outside docker use DB_HOST=localhost)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=${MYSQL_DATABASE}
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}
